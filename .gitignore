# Lab instruction / txn blobs (operator-captured; never default CI)
# Keep README + optional non-binary provenance notes tracked.
# Git cannot re-include files under an ignored directory unless dirs are un-ignored first.
testdata/xdna2_cmd/**
!testdata/xdna2_cmd/**/
!testdata/xdna2_cmd/README.md
!testdata/xdna2_cmd/**/PROVENANCE.md
!testdata/xdna2_cmd/**/*.sha256
!testdata/xdna2_cmd/**/*.txt

# Belt-and-suspenders: common mis-staged instruction paths outside staging dir
**/lab_instr.bin
**/ml_txn.bin
**/*_instr.bin
testdata/**/*.bin
testdata/**/*.elf
**/pm_ctrlpkt.bin

# Instruction ELFs often drop at repo root or tests/fixtures by mistake
*.elf

# Rescue kmod build debris (keep .c / Makefile; rebuild on host)
kernel/amdxdna_rescue/*.ko
kernel/amdxdna_rescue/*.o
kernel/amdxdna_rescue/*.mod
kernel/amdxdna_rescue/*.mod.c
kernel/amdxdna_rescue/*.mod.o
kernel/amdxdna_rescue/*.cmd
kernel/amdxdna_rescue/.*.cmd
kernel/amdxdna_rescue/..*.cmd
kernel/amdxdna_rescue/Module.symvers
kernel/amdxdna_rescue/modules.order
kernel/amdxdna_rescue/.module-common.o
kernel/amdxdna_rescue/.*.o

# Local env / secrets footguns
.env
.env.*

target/

# Lab: AMD DD txn dumps + fat dump tool binary (not for public commit)
tools/dump_dd_txn
target/dump_dd_txn
testdata/xdna2_cmd/dd_matmul_txn/

# Lab: pack_mladf_ref host buffers (ifm/wts/ofm binaries; keep PROVENANCE trackable)
tools/pack_mladf_ref
target/pack_mladf_ref
testdata/xdna2_cmd/mladf_ref/**
!testdata/xdna2_cmd/mladf_ref/
!testdata/xdna2_cmd/mladf_ref/PROVENANCE.md
!testdata/xdna2_cmd/mladf_ref/**/PROVENANCE.md
testdata/xdna2_cmd/silicon_lab/**
# Lab: AMD export_mladf_wts output (EULA-derived packed blobs; never commit)
tools/export_mladf_wts
target/export_mladf_wts
testdata/xdna2_cmd/mladf_wts_export/**
!testdata/xdna2_cmd/mladf_wts_export/
!testdata/xdna2_cmd/mladf_wts_export/PROVENANCE.md
!testdata/xdna2_cmd/mladf_wts_export/**/PROVENANCE.md

# OFM golden capture (vendor Option A; do not commit blobs)
testdata/xdna2_cmd/mladf_ofm_capture/**
!testdata/xdna2_cmd/mladf_ofm_capture/
!testdata/xdna2_cmd/mladf_ofm_capture/**/PROVENANCE*
target/capture_mladf_ofm_golden
